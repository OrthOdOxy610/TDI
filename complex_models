import struct
from pathlib import Path

import numpy as np
from scipy.ndimage import distance_transform_edt, gaussian_filter


INPUT_DIR = Path("input_dat")
OUTPUT_DIR = Path("generated_dat")

N_REALIZATIONS = 19
SEED_BASE = 0

VOID, CALCITE, DOLOMITE, QUARTZ = 0, 2, 3, 4


def read_dat(path):
    with path.open("rb") as handle:
        nx, ny, nz = struct.unpack("iii", handle.read(12))
        raw = handle.read(nx * ny * nz * 4)
    if nz != 1:
        raise ValueError(f"expected nz=1, got {nz}")
    if len(raw) != nx * ny * nz * 4:
        raise ValueError(f"unexpected payload length in {path.name}")
    return np.frombuffer(raw, dtype=np.int32).reshape(ny, nx).copy(), nx, ny, nz


def write_dat(path, data, nx, ny, nz=1):
    with path.open("wb") as handle:
        handle.write(struct.pack("iii", nx, ny, nz))
        handle.write(np.asarray(data, dtype=np.int32).tobytes())


class MineralTopologyGenerator:
    frac_quartz = 0.50
    frac_dolomite = 0.15

    def __init__(self, geometry, rng):
        self.geometry = geometry
        self.solid_mask = geometry != VOID
        self.ny, self.nx = geometry.shape
        self.rng = rng
        self.total_solid = int(self.solid_mask.sum())
        if self.total_solid == 0:
            raise ValueError("geometry contains no solid voxels")

    def _counts(self):
        n_quartz = int(self.total_solid * self.frac_quartz)
        n_dolomite = int(self.total_solid * self.frac_dolomite)
        return n_quartz, n_dolomite, self.total_solid - n_quartz - n_dolomite

    def _solid_coords(self):
        return np.where(self.solid_mask)

    def _apply(self, minerals):
        result = self.geometry.copy()
        result[self.solid_mask] = minerals[self.solid_mask]
        return result

    def homogeneous(self, scale=3.0):
        n_quartz, n_dolomite, n_calcite = self._counts()
        field = gaussian_filter(self.rng.normal(size=(self.ny, self.nx)), sigma=scale)
        yy, xx = self._solid_coords()
        order = np.argsort(field[yy, xx])
        minerals = np.zeros_like(self.geometry)
        minerals[yy[order[:n_quartz]], xx[order[:n_quartz]]] = QUARTZ
        reactive = order[n_quartz:]
        mixed = np.array([DOLOMITE] * n_dolomite + [CALCITE] * n_calcite, dtype=np.int32)
        self.rng.shuffle(mixed)
        minerals[yy[reactive], xx[reactive]] = mixed
        return self._apply(minerals)

    def layered(self, angle, scale=35.0):
        n_quartz, n_dolomite, _ = self._counts()
        y, x = np.indices((self.ny, self.nx))
        theta = np.radians(angle)
        field = np.sin(2 * np.pi * (x * np.cos(theta) + y * np.sin(theta)) / scale)
        yy, xx = self._solid_coords()
        order = np.argsort(field[yy, xx], kind="stable")
        minerals = np.zeros_like(self.geometry)
        minerals[yy[order[:n_quartz]], xx[order[:n_quartz]]] = QUARTZ
        band = order[n_quartz:n_quartz + n_dolomite]
        minerals[yy[band], xx[band]] = DOLOMITE
        rest = order[n_quartz + n_dolomite:]
        minerals[yy[rest], xx[rest]] = CALCITE
        return self._apply(minerals)

    def replacement(self, scale=10.0):
        n_quartz, n_dolomite, _ = self._counts()
        field = gaussian_filter(self.rng.normal(size=(self.ny, self.nx)), sigma=scale)
        yy, xx = self._solid_coords()
        order = np.argsort(field[yy, xx])
        minerals = np.zeros_like(self.geometry)
        quartz = order[:n_quartz]
        minerals[yy[quartz], xx[quartz]] = QUARTZ
        carbonate = order[n_quartz:]
        cy, cx = yy[carbonate], xx[carbonate]
        carbonate_mask = np.zeros_like(self.solid_mask)
        carbonate_mask[cy, cx] = True
        distances = distance_transform_edt(carbonate_mask)[cy, cx]
        effective = distances + self.rng.normal(0.0, 0.2, len(distances))
        local = np.argsort(effective)
        minerals[cy[local[:n_dolomite]], cx[local[:n_dolomite]]] = DOLOMITE
        minerals[cy[local[n_dolomite:]], cx[local[n_dolomite:]]] = CALCITE
        return self._apply(minerals)

    def fracture(self):
        n_quartz, n_dolomite, n_calcite = self._counts()
        skeleton = np.ones((self.ny, self.nx), dtype=bool)
        x = np.arange(self.nx)
        for _ in range(int(self.rng.integers(3, 6))):
            start = self.rng.uniform(0.1 * self.ny, 0.9 * self.ny)
            end = self.rng.uniform(0.1 * self.ny, 0.9 * self.ny)
            base = np.linspace(start, end, self.nx)
            low = gaussian_filter(self.rng.normal(size=self.nx), sigma=self.nx / 10) * (self.ny / 8)
            high = gaussian_filter(self.rng.normal(size=self.nx), sigma=self.nx / 50) * (self.ny / 25)
            curve = np.clip(base + low + high, 0, self.ny - 1).astype(int)
            skeleton[curve, x] = False
            skeleton[np.clip(curve - 1, 0, self.ny - 1), x] = False
            skeleton[np.clip(curve + 1, 0, self.ny - 1), x] = False
        distances = distance_transform_edt(skeleton)
        yy, xx = self._solid_coords()
        order = np.argsort(distances[yy, xx])
        minerals = np.zeros_like(self.geometry)
        minerals[yy[order[:n_calcite]], xx[order[:n_calcite]]] = CALCITE
        band = order[n_calcite:n_calcite + n_dolomite]
        minerals[yy[band], xx[band]] = DOLOMITE
        rest = order[n_calcite + n_dolomite:]
        minerals[yy[rest], xx[rest]] = QUARTZ
        return self._apply(minerals)


CONSTRUCTORS = {
    "homogeneous": lambda g: g.homogeneous(),
    "layered_0": lambda g: g.layered(angle=0.0, scale=35.0),
    "layered_90": lambda g: g.layered(angle=90.0, scale=35.0),
    "replacement": lambda g: g.replacement(),
    "fracture": lambda g: g.fracture(),
}


def main():
    source = sorted(INPUT_DIR.glob("*.dat"))
    if not source:
        raise FileNotFoundError(f"no .dat input found in {INPUT_DIR}")

    base, nx, ny, nz = read_dat(source[0])
    geometry = np.where(base == VOID, VOID, 1).astype(np.int32)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    for realization in range(1, N_REALIZATIONS + 1):
        for index, (name, constructor) in enumerate(CONSTRUCTORS.items()):
            seed = SEED_BASE + realization * 100 + index
            generator = MineralTopologyGenerator(geometry, np.random.default_rng(seed))
            data = constructor(generator)
            path = OUTPUT_DIR / f"{name}_{realization:02d}.dat"
            write_dat(path, data, nx, ny, nz)
        print(f"realization {realization:02d}/{N_REALIZATIONS}")


if __name__ == "__main__":
    main()
