import heapq
import os
import struct
from collections import deque

import numpy as np
import pandas as pd


CASE_SUBDIR = "sim_cases_final0"
GEO_SUBDIR = "geo"
GEO_PREFIX = "geo_"
INPUT_CSV = "evolution.csv"
OUTPUT_CSV = "evolution_with_index.csv"

NEIGHBORS = ((-1, 0), (1, 0), (0, -1), (0, 1))
TRACK_CURRENT_SOLID = True


def read_field(path):
    with open(path, "rb") as f:
        nx, ny, nz = struct.unpack("iii", f.read(12))
        raw = f.read(nx * ny * nz * 4)
    return np.frombuffer(raw, dtype=np.int32).reshape((ny, nx)), nx, ny


def geo_path(root, step):
    return os.path.join(root, GEO_SUBDIR, f"{GEO_PREFIX}{step:08d}.dat")


def external_void_mask(field):
    ny, nx = field.shape
    void = field == 0
    reachable = np.zeros_like(void, dtype=bool)
    queue = deque()

    for y in range(ny):
        for x in (0, nx - 1):
            if void[y, x] and not reachable[y, x]:
                reachable[y, x] = True
                queue.append((y, x))

    while queue:
        y, x = queue.popleft()
        for dy, dx in NEIGHBORS:
            j, i = y + dy, x + dx
            if 0 <= j < ny and 0 <= i < nx and void[j, i] and not reachable[j, i]:
                reachable[j, i] = True
                queue.append((j, i))

    return reachable


class DissolutionAnalyzer:
    def __init__(self, initial_field_path):
        self.cost_by_phase = {
            0: 0.0,
            2: 1.0,
            3: 50.0,
            4: float("inf"),
        }
        self.reference_cost = 1.0

        field, self.nx, self.ny = read_field(initial_field_path)
        self.initial_solid = field != 0
        self.solid_count = int(self.initial_solid.sum())
        self.u_char = float(self.ny) * self.reference_cost

    def cost_map(self, field):
        cost = np.zeros(field.shape, dtype=float)
        for phase, value in self.cost_by_phase.items():
            cost[field == phase] = value
        return cost

    def accumulated_cost(self, field):
        ny, nx = field.shape
        cost = self.cost_map(field)
        seeds = external_void_mask(field)

        dist = np.full((ny, nx), np.inf)
        heap = []

        for y, x in zip(*np.where(seeds)):
            y, x = int(y), int(x)
            dist[y, x] = 0.0
            heapq.heappush(heap, (0.0, y, x))

        while heap:
            d, y, x = heapq.heappop(heap)
            if d > dist[y, x]:
                continue
            for dy, dx in NEIGHBORS:
                j, i = y + dy, x + dx
                if 0 <= j < ny and 0 <= i < nx:
                    w = cost[j, i]
                    if w == np.inf:
                        continue
                    nd = d + w
                    if nd < dist[j, i]:
                        dist[j, i] = nd
                        heapq.heappush(heap, (nd, j, i))

        return dist

    def solid_mask(self, field):
        return field != 0 if TRACK_CURRENT_SOLID else self.initial_solid

    def topology_index(self, field):
        dist = self.accumulated_cost(field)
        mask = self.solid_mask(field)
        u = dist[mask]
        u = u[np.isfinite(u)]
        if u.size == 0 or self.solid_count == 0:
            return 0.0
        return float(np.sum(np.exp(-u / self.u_char)) / self.solid_count)


def process_job(root, model_name, verbose=True):
    initial_path = os.path.join(root, CASE_SUBDIR, f"{model_name}.dat")
    input_csv = os.path.join(root, INPUT_CSV)
    output_csv = os.path.join(root, OUTPUT_CSV)

    if not os.path.exists(initial_path) or not os.path.exists(input_csv):
        print(f"[skip] missing input for model: {model_name}")
        return None

    analyzer = DissolutionAnalyzer(initial_path)
    table = pd.read_csv(input_csv)
    if "topology_index" not in table.columns:
        table["topology_index"] = 0.0

    for i, row in table.iterrows():
        step = int(row["step"])
        path = geo_path(root, step)
        if not os.path.exists(path):
            continue
        field, _, _ = read_field(path)
        value = analyzer.topology_index(field)
        table.at[i, "topology_index"] = value
        if verbose and (step % 1000 == 0 or i == len(table) - 1):
            print(f"step={step:08d} index={value:.5f}")

    reference = table.loc[table["step"] == 0, "topology_index"].to_numpy()
    ref = float(reference[0]) if reference.size else 0.0
    table["index_norm"] = table["topology_index"] / ref if ref else 0.0

    step_arr = table["step"].to_numpy(dtype=float)
    table["d_porosity_d_step"] = np.gradient(
        table["porosity_norm"].to_numpy(dtype=float), step_arr
    )
    table["d_index_d_step"] = np.gradient(
        table["index_norm"].to_numpy(dtype=float), step_arr
    )

    table.to_csv(output_csv, index=False)
    print(f"[done] {model_name} -> {output_csv}")
    return output_csv


JOBS = [
    {"root": "/path/to/experiment_A/results1", "model": "model_01"},
    {"root": "/path/to/experiment_A/results2", "model": "model_02"},
    {"root": "/path/to/experiment_B/results1", "model": "model_03"},
]


def run_all(jobs):
    total = len(jobs)
    for i, job in enumerate(jobs):
        print(f"progress [{i + 1}/{total}] {job['model']}")
        try:
            process_job(job["root"], job["model"])
        except Exception as exc:
            print(f"[error] {job['model']}: {exc}")


if __name__ == "__main__":
    run_all(JOBS)
