import heapq
import os
import struct
from collections import deque

import numpy as np
import pandas as pd


CASE_SUBDIR = "sim_cases_final0"
GEO_SUBDIR = "geo"
GEO_PREFIX = "geo_"
INPUT_CSV = "evolution.csv"
OUTPUT_CSV = "evolution_with_metrics.csv"

NEIGHBORS = ((-1, 0), (1, 0), (0, -1), (0, 1))

METRIC_KEYS = (
    "u_mean",
    "u_p50",
    "u_p90",
    "decay_integral",
    "index",
    "open_fraction",
    "remain_fraction",
    "external_void_fraction",
    "isolated_void_fraction",
)


def read_field(path):
    with open(path, "rb") as f:
        nx, ny, nz = struct.unpack("iii", f.read(12))
        raw = f.read(nx * ny * nz * 4)
    return np.frombuffer(raw, dtype=np.int32).reshape((ny, nx)), nx, ny


def geo_path(root, step):
    return os.path.join(root, GEO_SUBDIR, f"{GEO_PREFIX}{step:08d}.dat")


def external_void_mask(field):
    ny, nx = field.shape
    void = field == 0
    reachable = np.zeros_like(void, dtype=bool)
    queue = deque()

    for y in range(ny):
        for x in (0, nx - 1):
            if void[y, x] and not reachable[y, x]:
                reachable[y, x] = True
                queue.append((y, x))

    while queue:
        y, x = queue.popleft()
        for dy, dx in NEIGHBORS:
            j, i = y + dy, x + dx
            if 0 <= j < ny and 0 <= i < nx and void[j, i] and not reachable[j, i]:
                reachable[j, i] = True
                queue.append((j, i))

    return reachable


class DissolutionAnalyzer:
    def __init__(self, initial_field_path, resistance_ratio=50.0):
        self.cost_by_phase = {
            0: 0.0,
            2: 1.0,
            3: float(resistance_ratio),
            4: float("inf"),
        }
        self.reference_cost = 1.0

        field, self.nx, self.ny = read_field(initial_field_path)
        self.reference_mask = field != 0
        self.reference_nodes = np.argwhere(self.reference_mask)
        self.reference_count = int(self.reference_nodes.shape[0])
        self.u_char = float(self.ny) * self.reference_cost

        if self.reference_count == 0:
            raise ValueError("reference set is empty")

    def cost_map(self, field):
        cost = np.zeros(field.shape, dtype=float)
        for phase, value in self.cost_by_phase.items():
            cost[field == phase] = value
        return cost

    def distance(self, field):
        ny, nx = field.shape
        cost = self.cost_map(field)
        seeds = external_void_mask(field)

        dist = np.full((ny, nx), np.inf)
        heap = []

        for y, x in np.argwhere(seeds):
            y, x = int(y), int(x)
            dist[y, x] = 0.0
            heapq.heappush(heap, (0.0, y, x))

        while heap:
            d, y, x = heapq.heappop(heap)
            if d > dist[y, x]:
                continue
            for dy, dx in NEIGHBORS:
                j, i = y + dy, x + dx
                if 0 <= j < ny and 0 <= i < nx:
                    w = cost[j, i]
                    if w == np.inf:
                        continue
                    nd = d + w
                    if nd < dist[j, i]:
                        dist[j, i] = nd
                        heapq.heappush(heap, (nd, j, i))

        return dist, seeds

    def snapshot(self, field):
        if field.shape != self.reference_mask.shape:
            raise ValueError("field shape mismatch")

        dist, seeds = self.distance(field)

        ys = self.reference_nodes[:, 0]
        xs = self.reference_nodes[:, 1]

        u = dist[ys, xs]
        finite = np.isfinite(u)
        n_ref = float(self.reference_count)

        u_open = u[finite]
        solid_now = np.count_nonzero(field[ys, xs] != 0)
        void_total = np.count_nonzero(field == 0)
        void_external = np.count_nonzero(seeds)

        if u_open.size:
            u_mean = float(u_open.mean())
            u_p50 = float(np.percentile(u_open, 50))
            u_p90 = float(np.percentile(u_open, 90))
            decay_integral = float(np.sum(np.exp(-u_open / self.u_char)))
        else:
            u_mean = 0.0
            u_p50 = 0.0
            u_p90 = 0.0
            decay_integral = 0.0

        external_fraction = float(void_external) / float(void_total) if void_total else 0.0

        return {
            "u_mean": u_mean,
            "u_p50": u_p50,
            "u_p90": u_p90,
            "decay_integral": decay_integral,
            "index": decay_integral / n_ref,
            "open_fraction": float(np.count_nonzero(finite)) / n_ref,
            "remain_fraction": float(solid_now) / n_ref,
            "external_void_fraction": external_fraction,
            "isolated_void_fraction": 1.0 - external_fraction,
        }

    def track(self, root, steps, verbose=True):
        rows = []
        for step in steps:
            path = geo_path(root, int(step))
            if not os.path.exists(path):
                continue
            field, _, _ = read_field(path)
            row = {"step": int(step)}
            row.update(self.snapshot(field))
            rows.append(row)
            if verbose and int(step) % 1000 == 0:
                print(
                    f"step={int(step):08d} "
                    f"index={row['index']:.5f} "
                    f"open={row['open_fraction']:.4f} "
                    f"remain={row['remain_fraction']:.4f}"
                )
        return pd.DataFrame.from_records(rows, columns=["step", *METRIC_KEYS])


def process_job(root, model_name, verbose=True):
    initial_path = os.path.join(root, CASE_SUBDIR, f"{model_name}.dat")
    input_csv = os.path.join(root, INPUT_CSV)
    output_csv = os.path.join(root, OUTPUT_CSV)

    if not os.path.exists(initial_path) or not os.path.exists(input_csv):
        print(f"[skip] missing input for model: {model_name}")
        return None

    analyzer = DissolutionAnalyzer(initial_path)
    table = pd.read_csv(input_csv)
    table["step"] = table["step"].astype(int)

    metrics = analyzer.track(root, sorted(table["step"].unique()), verbose=verbose)
    if metrics.empty:
        print(f"[skip] no snapshots for model: {model_name}")
        return None

    table = table.merge(metrics, on="step", how="left")
    table[list(METRIC_KEYS)] = table[list(METRIC_KEYS)].interpolate(limit_direction="both")
    table = table.sort_values("step").reset_index(drop=True)

    base = float(table["index"].iloc[0])
    table["index_norm"] = table["index"] / base if base else 0.0

    if len(table) > 1:
        step_arr = table["step"].to_numpy(dtype=float)
        table["d_index_norm_d_step"] = np.gradient(
            table["index_norm"].to_numpy(dtype=float), step_arr
        )
        table["d_open_fraction_d_step"] = np.gradient(
            table["open_fraction"].to_numpy(dtype=float), step_arr
        )
        if "porosity_norm" in table.columns:
            table["d_porosity_norm_d_step"] = np.gradient(
                table["porosity_norm"].to_numpy(dtype=float), step_arr
            )

    table.to_csv(output_csv, index=False)
    print(f"[done] {model_name} -> {output_csv}")
    return output_csv


JOBS = [
    {"root": "/path/to/experiment_A/results1", "model": "model_01"},
    {"root": "/path/to/experiment_A/results2", "model": "model_02"},
    {"root": "/path/to/experiment_B/results1", "model": "model_03"},
]


def run_all(jobs):
    total = len(jobs)
    for i, job in enumerate(jobs):
        print(f"progress [{i + 1}/{total}] {job['model']}")
        try:
            process_job(job["root"], job["model"])
        except Exception as exc:
            print(f"[error] {job['model']}: {exc}")


if __name__ == "__main__":
    run_all(JOBS)
